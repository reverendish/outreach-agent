# ── Auth ──────────────────────────────────────────────────────────────────────
# Google OAuth: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js v5: generate with `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3002

# Comma-separated emails allowed to log in
ALLOWED_USER_EMAILS=

# ── BFF → Lambda shared secret ────────────────────────────────────────────────
# Must match SSM param /outreach/internal_api_key
INTERNAL_API_KEY=

# ── DynamoDB table names (must match SAM stack name + suffix) ─────────────────
AWS_REGION=eu-west-2
USERS_TABLE=ish-outreach-agent-users

# ── Lambda function URLs ───────────────────────────────────────────────────────
# After `sam deploy`, find these in CloudFormation outputs or Lambda console.
CRM_LAMBDA_URL=
ACCOUNT_LAMBDA_URL=
DRAFTS_LAMBDA_URL=
GENERATE_LAMBDA_URL=
ENRICH_LAMBDA_URL=
SEND_LAMBDA_URL=
SEARCH_LAMBDA_URL=
SUPPRESSION_LAMBDA_URL=
