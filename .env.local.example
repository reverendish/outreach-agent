# Lambda API Gateway base URL (from `sam deploy` output: OutreachApiUrl)
NEXT_PUBLIC_LAMBDA_BASE=https://xxxxxxxxxx.execute-api.eu-west-2.amazonaws.com

# API key — must match SSM /outreach/api_key
# Set in Netlify: Site settings → Environment variables
NEXT_PUBLIC_OUTREACH_API_KEY=your-secret-key-here

# Legacy (no longer used directly — kept for reference)
# COMPANIES_HOUSE_API_KEY is now server-side in Lambda (SSM /outreach/companies_house_api_key)
